{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "automation-runner/flow-schema-v1",
  "title": "automation-runner YAML flow (schema v1)",
  "description": "Declarative flow documents load into WorkflowStep objects; execution semantics are owned by WorkflowRuntime. The hand-written validator in automation_runner.flow_schema is authoritative; this file is the published contract.",
  "type": "object",
  "required": ["workflow", "steps"],
  "additionalProperties": false,
  "properties": {
    "workflow": {"type": "string", "minLength": 1},
    "params": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "boolean"]}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/step"}
    }
  },
  "definitions": {
    "step": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "oneOf": [
        {"required": ["action"]},
        {"required": ["artifact"]},
        {"required": ["capability"]},
        {"required": ["assert"]}
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1,
          "description": "DriverSession action alias; sibling keys are interpolated action parameters."
        },
        "artifact": {
          "type": "object",
          "required": ["type", "name"],
          "additionalProperties": false,
          "properties": {
            "type": {"type": "string", "minLength": 1},
            "name": {"type": "string", "minLength": 1},
            "capture_on": {"enum": ["always", "failure"]}
          }
        },
        "capability": {
          "type": "object",
          "required": ["builder"],
          "additionalProperties": false,
          "properties": {
            "builder": {"type": "string", "minLength": 1},
            "name": {"type": "string", "minLength": 1},
            "params": {"type": "object"},
            "policy": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "timeout": {"type": "number", "minimum": 0},
                "max_attempts": {"type": "integer", "minimum": 1},
                "backoff": {"type": "number", "minimum": 0}
              }
            }
          }
        },
        "assert": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "required": ["element_present"],
          "additionalProperties": false,
          "properties": {
            "element_present": {
              "type": "object",
              "required": ["selector"],
              "additionalProperties": true,
              "properties": {
                "selector": {"type": "string", "minLength": 1},
                "by": {"type": "string"},
                "timeout": {"type": "number", "minimum": 0},
                "interval": {"type": "number", "minimum": 0}
              }
            }
          }
        }
      }
    }
  }
}
